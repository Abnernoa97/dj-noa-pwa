{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dj-noa-cloud-private",
  "main": "src/entry.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "DJ_NOA_CLOUD_REGISTRY", "class_name": "DJNoaCloudRegistry" }
    ]
  },
  "migrations": [
    { "tag": "dj-noa-cloud-g1", "new_sqlite_classes": ["DJNoaCloudRegistry"] }
  ]
}
